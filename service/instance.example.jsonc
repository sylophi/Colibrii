// An instance's Wrangler config. Copy it to instance.jsonc, which git
// ignores, replace every value in angle brackets and the examples, and
// deploy with `pnpm --filter ./service run deploy`. README.md walks
// through each value.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colibrii",
  "account_id": "<Cloudflare account id>",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // The hub address. Wrangler creates its DNS record and certificate on
  // deploy. The zone must be on the same Cloudflare account.
  "workers_dev": false,
  "routes": [{ "pattern": "hub.example.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colibrii",
      "database_id": "<printed by `wrangler d1 create colibrii`>",
      "migrations_dir": "migrations",
    },
  ],
  // Per client IP: 60 a minute for the routes that work before a device
  // credential is checked, 300 for the rest. A namespace id is any
  // integer unique within the account.
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_OPEN",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Invocation logs would record request URLs, and GET /connect carries
  // its ticket in one.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    // The zone that holds nothing but tunnels.
    "TUNNEL_DOMAIN": "example.link",
    "TUNNEL_ZONE_ID": "<the tunnel zone's id>",
    "CLOUDFLARE_ACCOUNT_ID": "<Cloudflare account id>",
    "APPS": [
      {
        "id": "inkwell",
        // The Clerk instance's PEM public key, on one line with \n for
        // each line break.
        "clerkPublicKey": "-----BEGIN PUBLIC KEY-----\n<…>\n-----END PUBLIC KEY-----",
        // The origins its Clerk session tokens come from.
        "origins": ["inkwell://app", "https://app.inkwell.example"],
        // Only for an app that signs in through OAuth or with a code.
        "oauthClientId": "<Clerk OAuth application's client id>",
        // Only for an app that has the service mint sign-in tokens: the
        // name of the Worker secret that holds its Clerk secret key.
        "clerkSecretName": "INKWELL_CLERK_SECRET_KEY",
        // Only to change it from 16.
        "deviceCap": 16,
      },
    ],
  },
}
